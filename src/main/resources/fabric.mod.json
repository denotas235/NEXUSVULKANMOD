{
  "schemaVersion": 1,
  "id": "vulkanmod",
  "version": "${version}",
  "name": "VulkanMod",
  "description": "Bring Vulkan to Minecraft!",
  "authors": ["Collateral"],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/xCollateral/VulkanMod"
  },
  "icon": "assets/vulkanmod/vlogo.png",
  "environment": "client",
  "entrypoints": {
    "client": ["net.vulkanmod.Initializer"]
  },
  "mixins": ["vulkanmod.mixins.json", "vulkanmod-astc.mixins.json"],
  "accessWidener": "vulkanmod.accesswidener",
  "depends": {
    "fabricloader": ">=0.14.14",
    "minecraft": ["1.21.9", "1.21.10", "1.21.11"]
  },
  "custom": {
    "fabric-renderer-api-v1:contains_renderer": true
  },
  "jars": [
    {"file": "META-INF/jars/lwjgl-vulkan.jar"},
    {"file": "META-INF/jars/lwjgl-vma.jar"},
    {"file": "META-INF/jars/lwjgl-shaderc.jar"},
    {"file": "META-INF/jars/lwjgl.jar"},
    {"file": "META-INF/jars/lwjgl-spvc.jar"}
  ]
}
